    {
      "id": "deck",
      "type": "text",
      "variant": "deck",
      "content": "Recording, counting and governing in the ancient world.",
      "order": 3,
      "relates_to": [],
      "spread_id": "s-tablets",
      "x": 14,
      "y": 75,
      "w": 74,
      "h": 14,
      "z": 1,
      "tone": "dark"
    },
    {
