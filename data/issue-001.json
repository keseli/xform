    {
      "id": "strange-document/p1",
      "type": "text",
      "variant": "body",
      "content": "A group of local residents petition the governor to repair a road that had become impassable. They argue that the damage was hurting trade, increasing prices, and making it difficult to bring goods to the city. In return, they request a temporary tax exemption to cover the costs.",
      "order": 35,
      "relates_to": [],
      "spread_id": null,
      "x": null,
