      "alt": "The flintlock mechanism of an eighteenth-century French infantry musket."
    },
    {
      "id": "allowance-for-error/cap-lock",
      "type": "text",
      "variant": "caption",
      "content": "A flintlock mechanism. Before gauges, each one fitted a single gun.",
      "order": 16,
      "relates_to": [
        "allowance-for-error/img-lock"
      ],
      "spread_id": "s-2",
      "x": 14,
      "y": 83,
